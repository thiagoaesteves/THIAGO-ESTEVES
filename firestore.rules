rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio_content/{documentId} {
      // Allow all visitors to read portfolio content
      allow read: if true;

      // Allow writes with editor verification or open update
      allow create, update: if true;

      allow delete: if false;
    }

    match /site_content/{documentId} {
      // Allow visitors to read and write site content metrics
      allow read: if true;
      allow create, update, write: if true;
      allow delete: if false;
    }

    match /config/{documentId} {
      // Allow visitors to read and editor to update profile config in real time
      allow read: if true;
      allow create, update, write: if true;
      allow delete: if false;
    }
  }
}
